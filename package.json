{
  "name": "@shankho/nuxt-blog",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./internal/nuxt/paths.mjs"
  },
  "scripts": {
    "build": "node scripts/tina-build.mjs && nuxt build",
    "deploy:prebuilt": "npm run build && npx vercel deploy --prebuilt",
    "deploy:prebuilt:prod": "npm run build && npx vercel deploy --prebuilt --prod",
    "dev": "nuxt prepare && nuxt dev",
    "dev:tina": "nuxt prepare && tinacms dev -c \"nuxt dev\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check ./",
    "format:fix": "prettier --write ./",
    "format:content": "prettier --write 'content/**'",
    "migrate": "node scripts/migrations/run-all-migrations.cjs",
    "migrate:prod": "NODE_ENV=production node scripts/migrations/run-all-migrations.cjs",
    "migrate:recreate": "node scripts/migrations/run-all-migrations.cjs --recreate",
    "migrate:recreate:prod": "NODE_ENV=production node scripts/migrations/run-all-migrations.cjs --recreate",
    "check:db:structure": "node scripts/check-table-structure.cjs",
    "check:db:structure:prod": "NODE_ENV=production node scripts/check-table-structure.cjs"
  },
  "devDependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@iconify/vue": "^4.1.1",
    "@nuxt/content": "^3.5.1",
    "@nuxt/eslint": "^1.2.0",
    "@nuxt/image": "^1.8.0",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/color-mode": "^3.3.2",
    "@nuxtjs/robots": "^5.2.6",
    "@nuxtjs/sitemap": "^7.2.10",
    "@nuxtjs/tailwindcss": "^6.11.4",
    "@resvg/resvg-js": "^2.6.2",
    "@stefanobartoletti/nuxt-social-share": "^0.6.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tinacms/cli": "^2.5.2",
    "@types/google.maps": "^3.58.1",
    "@types/pg": "^8.11.11",
    "@vueuse/core": "^10.9.0",
    "@vueuse/nuxt": "^10.9.0",
    "dotenv": "^17.2.3",
    "eslint-config-prettier": "^9.1.0",
    "feed": "^4.2.2",
    "fuse.js": "^7.0.0",
    "nuxt": "^3.17.1",
    "nuxt-icon": "^0.6.8",
    "nuxt-og-image": "^6.2.5",
    "prettier": "^3.5.3",
    "satori": "^0.19.2",
    "sharp": "^0.34.5",
    "tinacms": "^3.9.4",
    "typescript": "^5.8.2",
    "unenv": "^1.10.0"
  },
  "overrides": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@nuxtjs/google-analytics": "^2.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dompurify": "^3.4.0",
    "jspdf": "^4.2.1",
    "otplib": "^12.0.1",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "resend": "^6.6.0",
    "ua-parser-js": "^2.0.3"
  }
}
