{
  "name": "@shankho/nuxt-blog",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "imports": {
    "#internal/nuxt/paths": "./internal/nuxt/paths.mjs"
  },
  "scripts": {
    "build": "nuxt build",
    "deploy:prebuilt": "npm run build && npx vercel deploy --prebuilt",
    "deploy:prebuilt:prod": "npm run build && npx vercel deploy --prebuilt --prod",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check ./",
    "format:fix": "prettier --write ./",
    "migrate": "node scripts/migrations/run-migration.js",
    "migrate:prod": "NODE_ENV=production node scripts/migrations/run-migration.js",
    "migrate:logins": "node scripts/migrations/run-login-migration.js",
    "migrate:logins:prod": "NODE_ENV=production node scripts/migrations/run-login-migration.js",
    "migrate:page-visits": "node scripts/migrations/run-page-visits-migration.js",
    "migrate:page-visits:prod": "NODE_ENV=production node scripts/migrations/run-page-visits-migration.js",
    "migrate:planner:prod": "node scripts/migrations/run-planner-setup-prod.js",
    "migrate:auth": "node scripts/migrations/run-auth-migration.js",
    "migrate:auth:prod": "NODE_ENV=production node scripts/migrations/run-auth-migration.js",
    "migrate:oauth": "node scripts/migrations/run-oauth-providers-migration.js",
    "migrate:oauth:prod": "NODE_ENV=production node scripts/migrations/run-oauth-providers-migration.js",
    "migrate:calculator-templates": "node scripts/migrations/run-calculator-templates-migration.js",
    "migrate:calculator-templates:prod": "NODE_ENV=production node scripts/migrations/run-calculator-templates-migration.js",
    "check:db:structure": "node scripts/check-table-structure.js",
    "check:db:structure:prod": "NODE_ENV=production node scripts/check-table-structure.js",
    "test:tasks": "node scripts/tests/task-management.test.js",
    "test:tasks:prod": "NODE_ENV=production node scripts/tests/task-management.test.js"
  },
  "devDependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@iconify/vue": "^4.1.1",
    "@nuxt/content": "^3.5.1",
    "@nuxt/eslint": "^1.2.0",
    "@nuxt/fonts": "^0.11.0",
    "@nuxt/image": "^1.8.0",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/color-mode": "^3.3.2",
    "@nuxtjs/robots": "^5.2.6",
    "@nuxtjs/sitemap": "^7.2.10",
    "@nuxtjs/tailwindcss": "^6.11.4",
    "@stefanobartoletti/nuxt-social-share": "^0.6.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/google.maps": "^3.58.1",
    "@types/pg": "^8.11.11",
    "@vueuse/core": "^10.9.0",
    "@vueuse/nuxt": "^10.9.0",
    "dotenv": "^17.2.3",
    "eslint-config-prettier": "^9.1.0",
    "feed": "^4.2.2",
    "fuse.js": "^7.0.0",
    "nuxt": "^3.17.1",
    "nuxt-icon": "^0.6.8",
    "nuxt-og-image": "^5.0.2",
    "prettier": "^3.5.3",
    "sharp": "^0.34.5",
    "typescript": "^5.8.2",
    "unenv": "^1.10.0"
  },
