    "dompurify": "^3.2.5",
    "jspdf": "^4.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "resend": "^6.6.0",
    "ua-parser-js": "^2.0.3"
  }
